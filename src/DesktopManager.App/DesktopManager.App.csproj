<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Assets\tray32.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\tray.ico" />
    <Resource Include="Assets\tray32.png" />
    <Content Include="Assets\desktop-tool.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopManager.Core\DesktopManager.Core.csproj" />
    <ProjectReference Include="..\DesktopManager.Native\DesktopManager.Native.csproj" />
    <ProjectReference Include="..\DesktopManager.Ipc\DesktopManager.Ipc.csproj" />
    <ProjectReference Include="..\DesktopManager.Player.Wallpaper\DesktopManager.Player.Wallpaper.csproj" />
    <ProjectReference Include="..\DesktopManager.Player.Icons\DesktopManager.Player.Icons.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\desktop-tool.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Win32 版本资源：任务管理器/启动项/进程列表显示名（默认是 exe 文件名，真机反馈要求中文名） -->
    <AssemblyTitle>狠狠整理</AssemblyTitle>
    <Product>狠狠整理</Product>
    <FileDescription>狠狠整理 — 桌面图标收纳与动态壁纸</FileDescription>
  </PropertyGroup>

</Project>

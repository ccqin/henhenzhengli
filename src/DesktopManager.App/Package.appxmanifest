<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap desktop desktop4 desktop6">

  <Identity Name="qins.57884328A683A"
            Version="1.0.0.0"
            Publisher="CN=00588731-3034-463D-B8FD-357AAFC3D4E4" />

  <Properties>
    <DisplayName>狠狠整理</DisplayName>
    <PublisherDisplayName>qins</PublisherDisplayName>
    <Logo>Assets\store-logo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="zh-cn" />
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <!-- Win32 桌面全信任（Desktop Bridge）：WPF + Win32 + 子进程 + 桌面接管所需 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="DesktopManager.App"
                 Executable="DesktopManager.App.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="狠狠整理"
          Description="桌面图标收纳 + 动态壁纸：收纳盒分组、跨屏壁纸、视频壁纸、日志排障"
          BackgroundColor="#1B1B26"
          Square44x44Logo="Assets\icon44.png"
          Square150x150Logo="Assets\icon150.png" />
      <Extensions>
        <!-- 开机自启（MSIX 标准方式；桌面版走 HKCU Run，代码自动切换） -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="DesktopManagerStart"
                               Enabled="true"
                               DisplayName="狠狠整理" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>

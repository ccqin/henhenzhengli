<Window x:Class="DesktopManager.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopManager 设置" ShowInTaskbar="False" Width="980" Height="700"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1B1B26" Foreground="#E8E8F0">
    <!-- M5-UI（A+C 美化）：自定义标题栏 + 左导航右内容 + 卡片分区 + 隐式控件样式 + 预览缩略图。零依赖。 -->
    <Window.Resources>
        <!-- 按钮：圆角 + 悬停/按压态 -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A55"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#232338"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#232331"/>
                                <Setter Property="Foreground" Value="#666678"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航项（RadioButton）：圆角 + 悬停 + 选中强调 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B8C8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,9" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26263A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3E58"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表：透明底 + 圆角条目 + 悬停/选中 -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#20202E"/>
            <Setter Property="BorderBrush" Value="#2E2E40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D8D8E4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="8,6" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A3E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3E58"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8D8E4"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 卡片分区 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#232334"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#4CC2FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9898AC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A7A90"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    
        <DataTemplate x:Key="MonitorItemTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#4CC2FF" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFF" FontSize="13"/>
                    <TextBlock Text="{Binding Resolution}" FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#888"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter Property="Foreground" Value="#4CC2FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#AAA"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter Property="Foreground" Value="#4CC2FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Border Grid.Row="0" Background="#16161F" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#4CC2FF" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text="DesktopManager 设置" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#666678" FontSize="11"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="46" Padding="0"
                        Background="Transparent" Click="Close_Click" Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets" FontSize="12"/>
            </Grid>
        </Border>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 导航 -->
            <StackPanel Grid.Column="0" Margin="12,14,6,14">
                <RadioButton x:Name="NavArrange" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="屏幕排列" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavGroups" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE902;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="显示组" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMonitors" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="每屏壁纸" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- 内容 -->
            <Grid Grid.Column="1" Margin="8,14,16,14">
                <!-- 页 1：屏幕排列 -->
                <Border x:Name="PanelArrange" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="屏幕排列" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Canvas x:Name="PreviewCanvas" Width="560" Height="340" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Background="#1A1A26" ClipToBounds="True"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="&#xE72C;  刷新" Click="RefreshMonitors_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="当前显示器拓扑预览（矩形内为各屏当前壁纸缩略图）。调整排列请到 Windows 设置 → 屏幕（本机显示栈不允许第三方程序修改拓扑）。"/>
                    </StackPanel>
                </Border>

                <!-- 页 2：显示组 -->
                <Border x:Name="PanelGroups" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE902;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="显示组（组内屏共享壁纸，跨屏拼接）" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="GroupList" Height="120" Margin="0,14,0,0" SelectionChanged="GroupList_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="＋  新建组" Click="NewGroup_Click"/>
                            <Button Content="删除组" Margin="8,0,0,0" Click="DeleteGroup_Click"/>
                        </StackPanel>
                        <TextBlock Text="成员" Style="{StaticResource Label}"/>
                        <StackPanel x:Name="MemberChecks" MinHeight="48"/>
                        <TextBlock Text="组壁纸" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="GroupWallpaperText" Text="（无）" Foreground="#C8C8D8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="设置组壁纸…" Click="SetGroupWallpaper_Click"/>
                            <Button Content="清除组壁纸" Margin="8,0,0,0" Click="ClearGroupWallpaper_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 页 3：每屏壁纸 -->
                <Border x:Name="PanelMonitors" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="每屏独立壁纸" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="未被显示组覆盖的屏幕使用独立壁纸；组成员屏的壁纸由组统一管理。"/>
                        <ListBox x:Name="MonitorList" Height="140" ItemTemplate="{StaticResource MonitorItemTemplate}" Margin="0,12,0,0" SelectionChanged="MonitorList_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="设置壁纸…" Click="SetMonitorWallpaper_Click"/>
                            <Button Content="移除壁纸" Margin="8,0,0,0" Click="RemoveMonitorWallpaper_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

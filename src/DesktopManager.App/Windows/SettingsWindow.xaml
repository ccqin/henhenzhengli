<Window x:Class="DesktopManager.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopManager 设置" ShowInTaskbar="False" Width="980" Height="700"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1B1B26" Foreground="#E8E8F0">
    <!-- M5-UI（A+C 美化）：自定义标题栏 + 左导航右内容 + 卡片分区 + 隐式控件样式 + 预览缩略图。零依赖。 -->
    <Window.Resources>
        <!-- 按钮：圆角 + 悬停/按压态 -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A55"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#232338"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#232331"/>
                                <Setter Property="Foreground" Value="#666678"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 外观选择块（RadioButton）：圆角边框 + 选中强调 -->
        <Style x:Key="RadioTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B8C8"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="#24243A" BorderBrush="#3A3A55"
                                BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A88"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3E58"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CC2FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航项（RadioButton）：圆角 + 悬停 + 选中强调 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B8C8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,9" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26263A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3E58"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表：透明底 + 圆角条目 + 悬停/选中 -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#20202E"/>
            <Setter Property="BorderBrush" Value="#2E2E40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D8D8E4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="8,6" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A3E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3E58"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8D8E4"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 卡片分区 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#232334"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#4CC2FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9898AC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A7A90"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    
        <DataTemplate x:Key="MonitorItemTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#4CC2FF" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFF" FontSize="13"/>
                    <TextBlock Text="{Binding Resolution}" FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#888"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter Property="Foreground" Value="#4CC2FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#AAA"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter Property="Foreground" Value="#4CC2FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Border Grid.Row="0" Background="#16161F" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#4CC2FF" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text="DesktopManager 设置" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#666678" FontSize="11"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="46" Padding="0"
                        Background="Transparent" Click="Close_Click" Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets" FontSize="12"/>
            </Grid>
        </Border>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 导航 -->
            <StackPanel Grid.Column="0" Margin="12,14,6,14">
                <RadioButton x:Name="NavArrange" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="屏幕排列" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavGroups" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE902;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="显示组" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMonitors" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="每屏壁纸" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE771;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="外观" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMenu" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE712;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="右键菜单" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9F9;" Style="{StaticResource Glyph}"/>
                        <TextBlock Text="日志与操作" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- 内容 -->
            <Grid Grid.Column="1" Margin="8,14,16,14">
                <!-- 页 1：屏幕排列 -->
                <Border x:Name="PanelArrange" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="屏幕排列" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Canvas x:Name="PreviewCanvas" Width="560" Height="340" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Background="#1A1A26" ClipToBounds="True"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="&#xE72C;  刷新" Click="RefreshMonitors_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="当前显示器拓扑预览（矩形内为各屏当前壁纸缩略图）。调整排列请到 Windows 设置 → 屏幕（本机显示栈不允许第三方程序修改拓扑）。"/>
                    </StackPanel>
                </Border>

                <!-- 页 2：显示组 -->
                <Border x:Name="PanelGroups" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE902;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="显示组（组内屏共享壁纸，跨屏拼接）" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="GroupList" Height="120" Margin="0,14,0,0" SelectionChanged="GroupList_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="＋  新建组" Click="NewGroup_Click"/>
                            <Button Content="删除组" Margin="8,0,0,0" Click="DeleteGroup_Click"/>
                        </StackPanel>
                        <TextBlock Text="成员" Style="{StaticResource Label}"/>
                        <StackPanel x:Name="MemberChecks" MinHeight="48"/>
                        <TextBlock Text="组壁纸" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="GroupWallpaperText" Text="（无）" Foreground="#C8C8D8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="设置组壁纸…" Click="SetGroupWallpaper_Click"/>
                            <Button Content="清除组壁纸" Margin="8,0,0,0" Click="ClearGroupWallpaper_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 页 3：每屏壁纸 -->
                <Border x:Name="PanelMonitors" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="每屏独立壁纸" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="未被显示组覆盖的屏幕使用独立壁纸；组成员屏的壁纸由组统一管理。"/>
                        <ListBox x:Name="MonitorList" Height="140" ItemTemplate="{StaticResource MonitorItemTemplate}" Margin="0,12,0,0" SelectionChanged="MonitorList_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="设置壁纸…" Click="SetMonitorWallpaper_Click"/>
                            <Button Content="移除壁纸" Margin="8,0,0,0" Click="RemoveMonitorWallpaper_Click"/>
                            <Button x:Name="ClearGroupWallpaperBtn" Content="移除组壁纸" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="RemoveCoveringGroupWallpaper_Click"
                                    ToolTip="该屏所在显示组的组壁纸覆盖了独立壁纸；点击后清空组壁纸，组内各屏回退各自独立壁纸"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 页：外观 -->
                <Border x:Name="PanelAppearance" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE771;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="外观" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="桌面图标" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="IconSizeS" Content="小（32px）" Style="{StaticResource RadioTile}" Checked="IconSize_Checked" Tag="32"/>
                            <RadioButton x:Name="IconSizeM" Content="中（48px）" Style="{StaticResource RadioTile}" Margin="8,0,0,0" Checked="IconSize_Checked" Tag="48"/>
                            <RadioButton x:Name="IconSizeL" Content="大（64px）" Style="{StaticResource RadioTile}" Margin="8,0,0,0" Checked="IconSize_Checked" Tag="64"/>
                        </StackPanel>
                        <TextBlock Text="文字标签风格" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LabelShadow" Content="原生风（文字阴影）" Style="{StaticResource RadioTile}" Checked="LabelStyle_Checked" Tag="shadow"/>
                            <RadioButton x:Name="LabelPill" Content="现代胶囊" Style="{StaticResource RadioTile}" Margin="8,0,0,0" Checked="LabelStyle_Checked" Tag="pill"/>
                        </StackPanel>
                        <!-- 实时预览（字体图标示意尺寸；标签跟随风格选择切换样式） -->
                        <TextBlock Text="预览" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                        <Border Background="#3A4A5C" CornerRadius="6" Height="150" Margin="0,4,0,0" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" Margin="20,0">
                                <StackPanel Width="110" Margin="0,16,0,0">
                                    <TextBlock x:Name="PreviewGlyph" Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="#E8F0FF"
                                               HorizontalAlignment="Center"
                                               FontSize="{Binding Text, ElementName=PreviewIconSize}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=LabelShadow}" Value="True">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border x:Name="PreviewLabel" CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="示例文件.txt" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="90"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PreviewIconSize" Text="48" Visibility="Collapsed"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="改动立即生效并保存。新图标的网格排位间距跟随尺寸档；已有图标位置不变。"/>
                    </StackPanel>
                </Border>

                <!-- 页：右键菜单 -->
                <Border x:Name="PanelMenu" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE712;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="右键菜单" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="内置菜单项" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="MenuOpen" Content="打开" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                            <CheckBox x:Name="MenuRename" Content="重命名" Margin="14,0,0,0" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                            <CheckBox x:Name="MenuDelete" Content="删除" Margin="14,0,0,0" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                            <CheckBox x:Name="MenuLocate" Content="打开文件位置" Margin="14,0,0,0" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="MenuSystem" Content="「更多操作 ▸」系统菜单（打开方式 / 第三方扩展 / 属性等资源管理器同款）"
                                  Margin="0,10,0,0" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                        <TextBlock Text="自定义菜单项" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                        <ListBox x:Name="CustomMenuList" Height="150" Margin="0,4,0,0"
                                 SelectionChanged="CustomMenuList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding Name}" Foreground="#E8E8F0"/>
                                        <TextBlock Text="{Binding Command}" Foreground="#9090A8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="＋ 添加" Click="CustomMenuAdd_Click"/>
                            <Button Content="编辑" Margin="8,0,0,0" Click="CustomMenuEdit_Click"/>
                            <Button Content="删除" Margin="8,0,0,0" Click="CustomMenuDelete_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="命令占位符：{path}=文件完整路径，{dir}=所在目录。&#13;扩展名过滤：留空=所有文件；如填 jpg,png 则只在图片右键时显示。&#13;示例：名称「用 VSCode 打开」，命令 code &quot;{path}&quot;"/>
                    </StackPanel>
                </Border>

                <!-- 页 4：日志与操作 -->
                <Border x:Name="PanelLogs" Style="{StaticResource Card}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="日志与操作记录" Style="{StaticResource CardTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="LogLevelFilter" Width="110" Margin="16,0,0,0" SelectedIndex="0"
                                      SelectionChanged="LogFilter_Changed">
                                <ComboBoxItem Content="全部"/>
                                <ComboBoxItem Content="操作"/>
                                <ComboBoxItem Content="错误"/>
                                <ComboBoxItem Content="警告+错误"/>
                            </ComboBox>
                            <ComboBox x:Name="LogDaysFilter" Width="90" Margin="8,0,0,0" SelectedIndex="1"
                                      SelectionChanged="LogFilter_Changed">
                                <ComboBoxItem Content="今天"/>
                                <ComboBoxItem Content="3 天"/>
                                <ComboBoxItem Content="7 天"/>
                                <ComboBoxItem Content="30 天"/>
                            </ComboBox>
                            <Button Content="&#xE72C; 刷新" Margin="8,0,0,0" Click="LogRefresh_Click"/>
                            <Button Content="&#xE898; 导出" Margin="8,0,0,0" Click="LogExport_Click"/>
                            <Button Content="清空" Margin="8,0,0,0" Click="LogClear_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="LogGrid" Grid.Row="1" Margin="0,12,0,0"
                                  Background="Transparent" RowBackground="Transparent" Foreground="#E8E8F0"
                                  BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  FontSize="12" RowHeight="24"
                                  ItemsSource="{Binding}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#20202E"/>
                                    <Setter Property="Foreground" Value="#9090A8"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Ts}" Width="165">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#9090A8"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="WRN">
                                                    <Setter Property="Foreground" Value="#FFC46B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="OPS">
                                                    <Setter Property="Foreground" Value="#6BCBFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="INF">
                                                    <Setter Property="Foreground" Value="#9AA0B5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="类别" Binding="{Binding Source}" Width="130"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="LogCount" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                   Foreground="#666678" FontSize="11" Margin="0,0,0,4" Text=""/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

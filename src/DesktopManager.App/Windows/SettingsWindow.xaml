<Window x:Class="DesktopManager.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopManager 设置" Width="900" Height="640"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E" Foreground="#EEE">
    <!-- M5 设置窗口：左=排列只读预览；右=显示组 + 每屏独立壁纸（壁纸设置统一入口，桌面右键不再出现）。 -->
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：排列预览（只读） -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="屏幕排列" FontSize="16" Margin="0,0,0,8"/>
            <Canvas x:Name="PreviewCanvas" Width="560" Height="360" Background="#14141F" ClipToBounds="True"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="刷新" Padding="14,6" Click="RefreshMonitors_Click"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#999"
                       Text="当前显示器拓扑预览。调整排列请到 Windows 设置 → 屏幕（本机显示栈不允许第三方程序修改拓扑）。"/>
        </StackPanel>

        <!-- 右：显示组 + 每屏壁纸 -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="显示组（组内屏共享壁纸，跨屏拼接）" FontSize="16" Margin="0,0,0,8"/>
            <ListBox x:Name="GroupList" Height="110" SelectionChanged="GroupList_SelectionChanged"
                     Background="#14141F" Foreground="#EEE" BorderBrush="#333"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                <Button Content="新建组" Padding="14,6" Margin="0,0,8,0" Click="NewGroup_Click"/>
                <Button Content="删除组" Padding="14,6" Click="DeleteGroup_Click"/>
            </StackPanel>

            <TextBlock Text="成员" Foreground="#999" Margin="0,0,0,4"/>
            <StackPanel x:Name="MemberChecks" MinHeight="50"/>

            <TextBlock Text="组壁纸" Foreground="#999" Margin="0,10,0,4"/>
            <TextBlock x:Name="GroupWallpaperText" Text="（无）" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="设置组壁纸…" Padding="14,6" Margin="0,0,8,0" Click="SetGroupWallpaper_Click"/>
                <Button Content="清除组壁纸" Padding="14,6" Click="ClearGroupWallpaper_Click"/>
            </StackPanel>

            <TextBlock Text="每屏独立壁纸" FontSize="16" Margin="0,0,0,8"/>
            <ListBox x:Name="MonitorList" Height="80" SelectionChanged="MonitorList_SelectionChanged"
                     Background="#14141F" Foreground="#EEE" BorderBrush="#333"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="设置壁纸…" Padding="14,6" Margin="0,0,8,0" Click="SetMonitorWallpaper_Click"/>
                <Button Content="移除壁纸" Padding="14,6" Click="RemoveMonitorWallpaper_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

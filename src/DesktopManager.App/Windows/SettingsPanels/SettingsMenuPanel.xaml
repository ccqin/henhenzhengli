<UserControl x:Class="DesktopManager.App.Windows.SettingsPanels.SettingsMenuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{DynamicResource Card}">

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE712;" Style="{DynamicResource Glyph}"/>
                            <TextBlock Text="右键菜单" Style="{DynamicResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="内置菜单项" Style="{DynamicResource Label}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="MenuOpen" Content="打开" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                            <CheckBox x:Name="MenuRename" Content="重命名" Margin="14,0,0,0" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                            <CheckBox x:Name="MenuDelete" Content="删除" Margin="14,0,0,0" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                            <CheckBox x:Name="MenuLocate" Content="打开文件位置" Margin="14,0,0,0" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="MenuSystem" Content="「更多操作 ▸」系统菜单（打开方式 / 第三方扩展 / 属性等资源管理器同款）"
                                  Margin="0,10,0,0" Checked="MenuFlag_Changed" Unchecked="MenuFlag_Changed"/>
                        <TextBlock Text="自定义菜单项" Style="{DynamicResource Label}" Margin="0,16,0,0"/>
                        <ListBox x:Name="CustomMenuList" Height="150" Margin="0,4,0,0"
                                 SelectionChanged="CustomMenuList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding Name}" Foreground="#E8E8F0"/>
                                        <TextBlock Text="{Binding Command}" Foreground="#9090A8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="＋ 添加" Click="CustomMenuAdd_Click"/>
                            <Button Content="编辑" Margin="8,0,0,0" Click="CustomMenuEdit_Click"/>
                            <Button Content="删除" Margin="8,0,0,0" Click="CustomMenuDelete_Click"/>
                        </StackPanel>
                        <TextBlock Style="{DynamicResource Hint}" Margin="0,12,0,0"
                                   Text="命令占位符：{path}=文件完整路径，{dir}=所在目录。&#13;扩展名过滤：留空=所有文件；如填 jpg,png 则只在图片右键时显示。&#13;示例：名称「用 VSCode 打开」，命令 code &quot;{path}&quot;"/>
                        <TextBlock Text="系统菜单隐藏项（按文字匹配，如「7-Zip」「属性」）" Style="{DynamicResource Label}" Margin="0,16,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox x:Name="SysHiddenBox" Width="220" Padding="6,4" KeyDown="SysHiddenBox_KeyDown"/>
                            <Button Content="＋ 添加" Margin="8,0,0,0" Click="SysHiddenAdd_Click"/>
                            <Button Content="📋 查看当前菜单项" Margin="8,0,0,0" Click="SysMenuEnumerate_Click"
                                    ToolTip="列出系统菜单的全部项目（以桌面上第一个文件为例），点击条目可直接加入隐藏"/>
                        </StackPanel>
                        <ListBox x:Name="SysHiddenList" Height="70" Margin="0,8,0,0"
                                 MouseDoubleClick="SysHiddenList_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" Foreground="#E8E8F0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" Background="Transparent" Padding="6,2"
                                                Click="SysHiddenRemove_Click" Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                
    </Border>
</UserControl>

<UserControl x:Class="DesktopManager.App.Windows.SettingsPanels.SettingsPluginsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{DynamicResource Card}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE735;" Style="{DynamicResource Glyph}"/>
                <TextBlock Text="插件" Style="{DynamicResource CardTitle}" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{DynamicResource Hint}" Margin="0,8,0,0"
                       Text="桌面宠物、小组件、壁纸源等以插件形式扩展。内置插件随应用分发；第三方插件放入 %APPDATA%\DesktopManager\plugins 后重启应用。"/>
            <ListBox x:Name="PluginList" Margin="0,10,0,0" MinHeight="120"
                     HorizontalContentAlignment="Stretch" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Version}" Opacity="0.5" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Source}" Opacity="0.5" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Id}" Opacity="0.4" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ToggleButton Grid.Column="2" IsChecked="{Binding Enabled}" Content="启用"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>

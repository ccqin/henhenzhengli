<Window x:Class="DesktopManager.App.Windows.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WallpaperWindow" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Background="Black">
    <!-- M4：壁纸内容层。静态图/GIF 帧走 Image；视频走 MediaElement（互斥显隐）。
         本窗口刻意**不开 AllowsTransparency**：① MediaElement 在透明窗内不渲染（WPF 硬约束）；
         ② 无壁纸时靠 Visibility=Hidden 让系统壁纸透出，不靠透明。 -->
    <Grid>
        <Image x:Name="WallpaperImage" Stretch="UniformToFill"/>
        <MediaElement x:Name="WallpaperVideo" Stretch="UniformToFill" Visibility="Collapsed"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual" Volume="0"
                      IsHitTestVisible="False" ScrubbingEnabled="False"/>
    </Grid>
</Window>

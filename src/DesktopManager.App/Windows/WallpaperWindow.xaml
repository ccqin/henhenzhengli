<Window x:Class="DesktopManager.App.Windows.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WallpaperWindow" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Background="Black">
    <!-- M4/M5：壁纸内容层。根 Canvas + ClipToBounds：单屏模式内容铺满窗口；
         组模式内容按虚拟画布尺寸放置并负偏移，窗口只裁出本屏区域（跨屏拼接，接缝天然对齐）。
         不开 AllowsTransparency（MediaElement 透明窗不渲染）；无壁纸 Visibility=Hidden 透出系统壁纸。 -->
    <Canvas x:Name="RootCanvas" ClipToBounds="True" Background="Black"/>
</Window>

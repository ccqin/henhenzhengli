<Window x:Class="DesktopManager.App.Windows.CustomMenuItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义菜单项" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#1B1B26" Foreground="#E8E8F0" WindowStyle="ToolWindow">
    <StackPanel Margin="16">
        <TextBlock Text="名称（菜单里显示的文字）" Foreground="#B8B8C8" FontSize="12"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,12" Padding="6,4"/>

        <TextBlock Text="命令（占位符：{path}=文件路径，{dir}=所在目录）" Foreground="#B8B8C8" FontSize="12"/>
        <TextBox x:Name="CommandBox" Margin="0,4,0,4" Padding="6,4"/>
        <TextBlock Text="示例：code &quot;{path}&quot;　或　notepad &quot;{path}&quot;" Foreground="#666678" FontSize="11" Margin="0,0,0,12"/>

        <TextBlock Text="扩展名过滤（留空=所有文件；如 jpg,png）" Foreground="#B8B8C8" FontSize="12"/>
        <TextBox x:Name="ExtBox" Margin="0,4,0,16" Padding="6,4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Click="Ok_Click"/>
            <Button Content="取消" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

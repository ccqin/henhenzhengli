<UserControl x:Class="DesktopManager.Player.Icons.FenceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Background="Transparent"
             MouseMove="Fence_MouseMove"
             MouseLeftButtonDown="Fence_MouseLeftButtonDown"
             MouseLeftButtonUp="Fence_MouseLeftButtonUp"
             DragOver="Fence_DragOver"
             Drop="Fence_Drop">
    <!-- M2 真机修复 Bug 1：AllowDrop 提升到 UserControl 根，覆盖整个盒子（Border/HeaderBar/内容区）。
         原先仅 ContentArea（WrapPanel）接收 Drop：空盒 MinHeight=20，折叠态 Collapsed，命中标题栏/边框时
         事件 bubble 到 IconCanvas_Drop（无 owner → no-op）。根级 Drop handler 调 AddIcon，e.Handled 阻止冒泡。 -->
    <!-- 收纳盒：半透明黑底圆角，淡白描边。MinWidth/MinHeight 保证折叠/空盒仍可见可点 -->
    <Border CornerRadius="6"
            Background="#80000000"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            Padding="6"
            MinWidth="120">
        <!-- Grid 承载主 StackPanel（边缘 resize 改由 UserControl 根的鼠标事件处理，见 code-behind）。 -->
        <Grid>
            <StackPanel>
                <!-- 顶栏=标题栏，整体可拖动；双击进入标题编辑（见 code-behind） -->
                <Grid x:Name="HeaderBar"
                      Background="Transparent"
                      MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                      MouseMove="HeaderBar_MouseMove"
                      MouseLeftButtonUp="HeaderBar_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText"
                               Grid.Column="0"
                               Text="Fence"
                               Foreground="White"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TitleEdit"
                             Grid.Column="0"
                             Visibility="Collapsed"
                             Background="#80000000"
                             Foreground="White"
                             BorderBrush="#40FFFFFF"
                             CaretBrush="White"
                             KeyDown="TitleEdit_KeyDown"
                             LostFocus="TitleEdit_LostFocus" />
                    <Button x:Name="FoldButton"
                            Grid.Column="1"
                            Content="▾"
                            Width="22"
                            Height="22"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Click="FoldButton_Click" />
                </Grid>
                <!-- 内容区：承载归属图标（T3 填充）；折叠时 Visibility=Collapsed。
                     Drop 接收已提升到 UserControl 根（Fence_Drop），本元素不再单独需要 AllowDrop。 -->
                <WrapPanel x:Name="ContentArea"
                           Margin="0,4,0,0"
                           MinHeight="20" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<Window x:Class="DesktopManager.Player.Icons.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" MinWidth="320"
        KeyDown="Window_KeyDown">
    <!-- M2-T5：自定义重命名对话框（brief 推荐方案 a）。
         半透明黑底白字，与 IconLayer 散落图标 label / FenceControl 标题编辑风格协调。 -->
    <Border Background="#E6000000" CornerRadius="8" Padding="16" Margin="10">
        <StackPanel>
            <TextBlock x:Name="Prompt" Foreground="White" Margin="0,0,0,8"/>
            <TextBox x:Name="Input" Foreground="White" Background="#66000000"
                     BorderBrush="#80FFFFFF" BorderThickness="1" Padding="6,4"
                     CaretBrush="White" SelectionBrush="#3399FF"
                     MinWidth="270"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="确定" Width="74" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="取消" Width="74" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DesktopManager.Player.Icons</AssemblyName>
    <RootNamespace>DesktopManager.Player.Icons</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopManager.Core\DesktopManager.Core.csproj" />
    <ProjectReference Include="..\DesktopManager.Ipc\DesktopManager.Ipc.csproj" />
    <ProjectReference Include="..\DesktopManager.Native\DesktopManager.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标层日志 → stderr（主进程 ChildProcessManager 统一转发进主日志/db） -->
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

</Project>

<Window x:Class="DesktopManager.Player.Wallpaper.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WallpaperPlayer" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Background="Black">
    <!-- 壁纸内容层。根 Canvas + ClipToBounds：单屏模式内容铺满窗口；
         组模式内容按虚拟画布尺寸放置并负偏移，窗口只裁出本屏区域（跨屏拼接）。 -->
    <Canvas x:Name="RootCanvas" ClipToBounds="True" Background="Black"/>
</Window>
